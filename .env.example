# Copy to .env (gitignored) and fill in. Never commit .env.

# From Graph API Explorer (expires ~1h); run `make long-token` to swap for ~60 days.
META_TOKEN=
# Your Instagram business account's user id (from me/accounts?fields=instagram_business_account)
IG_USER_ID=

# Only needed for `make long-token`. App dashboard -> App settings -> Basic.
META_APP_ID=
META_APP_SECRET=

# Local Postgres password. Anything; it only exists inside kind.
POSTGRES_PASSWORD=change-me

# Only if the repo is private: Argo CD read access (`make argocd-repo`).
# Fine-grained token, this repo only, Contents: read-only.
GITHUB_TOKEN=
